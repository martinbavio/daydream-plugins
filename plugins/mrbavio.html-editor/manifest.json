{
  "id": "mrbavio.html-editor",
  "name": "HTML editor",
  "version": "0.2.1",
  "minCore": "0.1.39",
  "contributes": {
    "panels": [
      "html-editor"
    ],
    "commands": [
      "mrbavio.html-editor.blur",
      "mrbavio.html-editor.undo",
      "mrbavio.html-editor.redo",
      "mrbavio.html-editor.delete-element",
      "mrbavio.html-editor.save-over"
    ],
    "shortcuts": {
      "Escape": "mrbavio.html-editor.blur",
      "Mod+Z": "mrbavio.html-editor.undo",
      "Shift+Mod+Z": "mrbavio.html-editor.redo",
      "Mod+S": "mrbavio.html-editor.save-over",
      "Delete": "mrbavio.html-editor.delete-element",
      "Backspace": "mrbavio.html-editor.delete-element"
    }
  },
  "built": "dist/index.js"
}
